{
  "name": "tehzeeb-sweets-pos",
  "private": true,
  "version": "1.0.11",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "electron:dev": "concurrently \"npm run dev\" \"electron .\"",
    "build-app": "npm run build && electron-builder"
  },
  "build": {
    "appId": "com.tehzeebsweets.pos",
    "productName": "Tehzeeb Sweets & Super Store",
    "directories": {
      "output": "dist_desktop"
    },
    "extraResources": [
      {
        "from": "server.exe",
        "to": "server.exe"
      }
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "Hammad55553",
        "repo": "TEHZEEB-POS",
        "releaseType": "release"
      }
    ],
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.png"
    },
    "mac": {
      "target": "dmg",
      "icon": "build/icon.png"
    }
  },
  "dependencies": {
    "@reduxjs/toolkit": "^2.12.0",
    "@supabase/supabase-js": "^2.105.1",
    "electron-updater": "^6.8.3",
    "exceljs": "^4.4.0",
    "framer-motion": "^12.33.0",
    "immer": "^11.1.18",
    "lucide-react": "^0.563.0",
    "react": "^19.2.0",
    "react-barcode": "^1.6.1",
    "react-dom": "^19.2.0",
    "react-hot-toast": "^2.6.0",
    "react-redux": "^9.2.0",
    "react-router-dom": "^7.13.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "concurrently": "^8.2.2",
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "vite": "^7.2.4"
  }
}